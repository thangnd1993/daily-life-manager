# Copy to .env.production and replace every CHANGE_ME value before deployment.
POSTGRES_DB=daily_life_manager
POSTGRES_USER=daily_life_manager
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
DATABASE_URL=postgresql://daily_life_manager:CHANGE_ME_URL_ENCODED_DATABASE_PASSWORD@postgres:5432/daily_life_manager?schema=public

JWT_ACCESS_SECRET=CHANGE_ME_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=https://admin.example.com
TRUST_PROXY_HOPS=1
ADMIN_PORT=8080

GOLD_PROVIDER=pha
GOLD_PROVIDER_BASE_URL=https://www.pha.vn/api/v1
GOLD_PROVIDER_API_KEY=CHANGE_ME_RUNTIME_ONLY
GOLD_PROVIDER_TIMEOUT_MS=5000

# Use a compact, single-line service-account JSON value supplied by the runtime.
# Leave empty only when push delivery is intentionally disabled.
FIREBASE_SERVICE_ACCOUNT_JSON=

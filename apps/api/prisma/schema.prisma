generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SystemRecord {
  id        String   @id @default(cuid())
  key       String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AttendanceSource {
  MOBILE
  WEB
  ADMIN
  AUTO
}

enum AttendanceStatus {
  WORKED
  OFF
}

enum FinanceTransactionType {
  INCOME
  EXPENSE
}

enum Currency {
  VND
}

enum GoldAlertPriceSide {
  BUY
  SELL
}

enum GoldAlertCondition {
  ABOVE
  BELOW
  PERCENT_CHANGE
}

enum PushPlatform {
  IOS
  ANDROID
}

enum NotificationType {
  GOLD_ALERT
  ATTENDANCE_AUTO_RECORDED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  PARTIAL
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

model User {
  id                      String                @id @default(cuid())
  email                   String                @unique
  passwordHash            String
  displayName             String
  role                    UserRole              @default(USER)
  status                  UserStatus            @default(ACTIVE)
  emailVerifiedAt         DateTime?
  lastLoginAt             DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  attendanceEnabled       Boolean               @default(false)
  leaveModeEnabled        Boolean               @default(false)
  leaveModeStartedAt      DateTime?
  leaveReason             String?
  attendanceTimezone      String                @default("Asia/Ho_Chi_Minh")
  defaultDailyWorkMinutes Int                   @default(240)
  authSessions            AuthSession[]
  passwordResetTokens     PasswordResetToken[]
  attendances             Attendance[]
  transactionCategories   TransactionCategory[]
  financeTransactions     FinanceTransaction[]
  financeBudgets          FinanceBudget[]
  goldAlerts              GoldAlert[]
  goldAlertTriggers       GoldAlertTrigger[]
  pushDevices             PushDevice[]
  notifications           Notification[]
  auditLogs               AuditLog[]

  @@index([status])
}

model AuditLog {
  id          String       @id @default(cuid())
  actorUserId String?
  actorRole   UserRole?
  action      String
  targetType  String
  targetId    String?
  outcome     AuditOutcome
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime     @default(now())
  actor       User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([targetType, targetId, createdAt(sort: Desc)])
}

model GoldAlert {
  id                   String             @id @default(cuid())
  userId               String
  productCode          String
  priceSide            GoldAlertPriceSide
  condition            GoldAlertCondition
  thresholdAmount      BigInt?
  thresholdBasisPoints Int?
  isEnabled            Boolean            @default(true)
  cooldownMinutes      Int                @default(60)
  lastTriggeredAt      DateTime?
  wasMatching          Boolean            @default(false)
  lastEvaluatedAt      DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  triggers             GoldAlertTrigger[]

  @@index([userId])
  @@index([productCode, isEnabled])
}

model GoldAlertTrigger {
  id                String             @id @default(cuid())
  alertId           String
  userId            String
  productCode       String
  observedBuyPrice  BigInt
  observedSellPrice BigInt
  matchedValue      String
  condition         GoldAlertCondition
  triggeredAt       DateTime           @default(now())
  alert             GoldAlert          @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification      Notification?

  @@index([userId, triggeredAt(sort: Desc)])
  @@index([alertId, triggeredAt(sort: Desc)])
}

model PushDevice {
  id         String                 @id @default(cuid())
  userId     String
  platform   PushPlatform
  pushToken  String                 @unique
  isActive   Boolean                @default(true)
  lastSeenAt DateTime               @default(now())
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, isActive])
}

model Notification {
  id                 String                 @id @default(cuid())
  userId             String
  type               NotificationType
  title              String
  body               String
  data               Json
  status             NotificationStatus     @default(PENDING)
  goldAlertTriggerId String?                @unique
  attendanceId       String?                @unique
  createdAt          DateTime               @default(now())
  sentAt             DateTime?
  failedAt           DateTime?
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  goldAlertTrigger   GoldAlertTrigger?      @relation(fields: [goldAlertTriggerId], references: [id], onDelete: Cascade)
  attendance         Attendance?            @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  deliveries         NotificationDelivery[]

  @@index([userId, createdAt(sort: Desc)])
}

model NotificationDelivery {
  id                String                     @id @default(cuid())
  notificationId    String
  deviceId          String
  status            NotificationDeliveryStatus @default(PENDING)
  providerMessageId String?
  attemptCount      Int                        @default(0)
  lastAttemptAt     DateTime?
  errorCode         String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  notification      Notification               @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  device            PushDevice                 @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([notificationId, deviceId])
}

model TransactionCategory {
  id           String                 @id @default(cuid())
  userId       String?
  name         String
  type         FinanceTransactionType
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  user         User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions FinanceTransaction[]
  budgets      FinanceBudget[]

  @@unique([userId, name, type])
  @@index([userId, type])
}

model FinanceBudget {
  id         String               @id @default(cuid())
  userId     String
  year       Int
  month      Int
  categoryId String?
  amount     BigInt
  currency   Currency             @default(VND)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   TransactionCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, year, month])
  @@index([categoryId])
}

model GoldPriceSnapshot {
  id              String   @id @default(cuid())
  provider        String
  productCode     String
  productName     String
  buyPrice        BigInt
  sellPrice       BigInt
  currency        Currency @default(VND)
  unit            String
  sourceTimestamp DateTime
  fetchedAt       DateTime @default(now())
  fingerprint     String   @unique
  createdAt       DateTime @default(now())

  @@index([productCode, sourceTimestamp(sort: Desc)])
  @@index([provider, fetchedAt(sort: Desc)])
}

model FinanceTransaction {
  id          String                 @id @default(cuid())
  userId      String
  type        FinanceTransactionType
  amount      BigInt
  currency    Currency               @default(VND)
  categoryId  String
  description String?
  occurredAt  DateTime
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    TransactionCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, occurredAt(sort: Desc)])
  @@index([categoryId])
}

model Attendance {
  id             String           @id @default(cuid())
  userId         String
  attendanceDate DateTime         @db.Date
  checkedInAt    DateTime         @default(now())
  workedMinutes  Int              @default(240)
  status         AttendanceStatus @default(WORKED)
  offReason      String?
  autoRecordedAt DateTime?
  timezone       String
  source         AttendanceSource
  note           String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification   Notification?

  @@unique([userId, attendanceDate])
  @@index([userId, attendanceDate(sort: Desc)])
}

model AuthSession {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  deviceName String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
}
